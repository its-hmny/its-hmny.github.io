    {
      "id": "7B4wDCEn-rkhthlw8ZMWd",
      "type": "text",
      "x": 1028.4645479986937,
      "y": 109.43383020296793,
      "width": 349.7921477995605,
      "height": 46.391930084513234,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
