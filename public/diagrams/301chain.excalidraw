    {
      "id": "l3-note",
      "type": "text",
      "x": 387.3747871169327,
      "y": 279.63369829342946,
      "width": 549.4118564397953,
      "height": 141.8661182664514,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
