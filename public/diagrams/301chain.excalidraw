      "roundness": null,
      "seed": 132,
      "version": 1090,
      "versionNonce": 1595413774,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785089689956,
      "link": null,
      "locked": false,
      "text": "Abstracts Stellar concepts (trustlines, fee sponsoring) — designed\nto support multiple blockchains\n• Auto-scaling replicas based on traffic load\n• Full tracing and metric production baked in since day 1\n• Built with modularity and extensibility in mind\n• Possibility to support of other blockchains\n• Possibility to support other providers/usecase (Fireblocks, Fees)",
      "fontSize": 16.213270659023017,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Abstracts Stellar concepts (trustlines, fee sponsoring) — designed to support multiple blockchains\n• Auto-scaling replicas based on traffic load\n• Full tracing and metric production baked in since day 1\n• Built with modularity and extensibility in mind\n• Possibility to support of other blockchains\n• Possibility to support other providers/usecase (Fireblocks, Fees)",
      "lineHeight": 1.25,
      "index": "aN",
      "autoResize": false
    },
